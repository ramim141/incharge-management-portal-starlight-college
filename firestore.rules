rules_version = '2';

// Server-side access control. The app hides other classes in the UI, but THIS is what
// actually stops a teacher from reading or changing another teacher's class.
//
//   principal (role: superadmin) → everything (signs in with email)
//   teachers sign in with a login ID (T001) looked up in loginIds/{ID}
//   in-charge (role: incharge)   → only classes/{their classId} and its sub-collections
//   students (not signed in)     → only a portal/{key} doc whose key they can compute
//                                  from class + roll + PIN (get only, never list)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userDoc()); }
    function me() { return get(userDoc()).data; }
    function isActive() { return me().get('active', true) != false; }
    function isPrincipal() { return hasProfile() && me().role == 'superadmin' && isActive(); }
    function isInchargeOf(classId) {
      return hasProfile() && me().role == 'incharge' && isActive() && me().get('classId', null) == classId;
    }
    function canManage(classId) { return isPrincipal() || isInchargeOf(classId); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    function ownerDoc() { return /databases/$(database)/documents/meta/owner; }
    // First-run setup: allowed only while no owner exists, in the same batch that creates it
    function isBootstrapping() {
      return signedIn() && !exists(ownerDoc()) && getAfter(ownerDoc()).data.uid == request.auth.uid;
    }

    match /meta/institution {
      allow read: if true;  // name shown on the public student portal
      allow create: if isPrincipal() || isBootstrapping();
      allow update: if isPrincipal();
      allow delete: if false;
    }

    match /meta/classIndex {
      allow read: if true;  // class names for the portal's class picker (no student data)
      allow write: if isPrincipal();
    }

    match /meta/staffCounter {
      allow read, write: if isPrincipal();  // last teacher login-ID number + prefix
    }

    match /meta/owner {
      allow get: if true;   // the login screen checks whether first-run setup is needed
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !exists(ownerDoc());
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPrincipal());
      allow list: if isPrincipal();
      allow create: if isPrincipal()
        || (isBootstrapping() && request.auth.uid == uid && request.resource.data.role == 'superadmin');
      // Teachers may edit their own name/phone/designation and account fields (after changing their
      // password or linking a recovery email) — never role, class, login ID or active
      allow update: if isPrincipal()
        || (request.auth.uid == uid
            && onlyChanges(['name', 'phone', 'designation', 'mustChangePassword', 'email', 'pendingEmail']));
      allow delete: if isPrincipal();
    }

    match /classes/{classId} {
      allow get: if canManage(classId);
      allow list: if isPrincipal();
      allow create, delete: if isPrincipal();
      // In-charges can change fee rules / template / their contact info and the cached stats,
      // but not the class name, code or who the in-charge is
      allow update: if isPrincipal()
        || (isInchargeOf(classId)
            && onlyChanges(['settings', 'inchargeName', 'inchargePhone', 'inchargeDesignation', 'stats', 'statsHash']));

      // The audit log is append-only: entries can be added and read, never edited or removed
      match /audit/{docId} {
        allow read, create: if canManage(classId);
        allow update, delete: if false;
      }

      // A guardian applies for leave from the student portal (not signed in).
      match /leaves/{leaveId} {
        allow create: if request.resource.data.keys().hasOnly(['id', 'classId', 'studentId', 'roll', 'studentName', 'portalKey', 'from', 'to', 'reason', 'status', 'createdAt'])
          && request.resource.data.id == leaveId
          && request.resource.data.classId == classId
          && request.resource.data.status == 'pending'
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 300
          && request.resource.data.from is string && request.resource.data.from.size() == 10
          && request.resource.data.to is string && request.resource.data.to.size() == 10
          && exists(/databases/$(database)/documents/portal/$(request.resource.data.portalKey))
          && (get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.classId == classId
              || get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.cls.code == classId)
          && (get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.student.id == request.resource.data.studentId
              || get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.student.studentId == request.resource.data.studentId);
      }

      // A student submits a query/question from the student portal (not signed in).
      match /queries/{queryId} {
        allow create: if request.resource.data.keys().hasOnly(['id', 'classId', 'studentId', 'roll', 'studentName', 'portalKey', 'subject', 'message', 'status', 'createdAt', 'reply', 'repliedAt', 'repliedBy', 'sender', 'senderName', 'text'])
          && request.resource.data.id == queryId
          && request.resource.data.classId == classId
          && request.resource.data.status == 'pending'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 600
          && exists(/databases/$(database)/documents/portal/$(request.resource.data.portalKey))
          && (get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.classId == classId
              || get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.cls.code == classId)
          && (get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.student.id == request.resource.data.studentId
              || get(/databases/$(database)/documents/portal/$(request.resource.data.portalKey)).data.student.studentId == request.resource.data.studentId);
      }

      // Students can change their own PIN if their current portalKey exists
      match /students/{studentId} {
        allow read: if canManage(classId);
        allow create, delete: if canManage(classId);
        allow update: if canManage(classId)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'portalKey', 'portalHash'])
              && request.resource.data.pin is string
              && request.resource.data.pin.size() >= 4 && request.resource.data.pin.size() <= 8
              && exists(/databases/$(database)/documents/portal/$(resource.data.portalKey)));
      }

      match /{collection}/{docId} {
        allow read, write: if canManage(classId) && collection != 'audit';
      }
    }

    // Teacher login ID (T001) → the account's email, so teachers can sign in with the ID.
    // Read one by exact ID only (never list); the owner may update where their login email points.
    match /loginIds/{id} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if isPrincipal();
      allow update: if isPrincipal()
        || (signedIn() && resource.data.uid == request.auth.uid && onlyChanges(['email', 'pendingEmail']));
    }

    match /portal/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if canManage(request.resource.data.classId)
        || (request.resource.data.prevPortalKey != null
            && exists(/databases/$(database)/documents/portal/$(request.resource.data.prevPortalKey))
            && get(/databases/$(database)/documents/portal/$(request.resource.data.prevPortalKey)).data.student.id == request.resource.data.student.id);
      allow update: if canManage(resource.data.classId) && canManage(request.resource.data.classId);
      // Deleting a record that was never written is a no-op; allow it so a batch doesn't fail
      allow delete: if (signedIn() && (resource == null || canManage(resource.data.classId)))
        || (resource != null && resource.data.student.id is string);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
